# ═══════════════════════════════════════════════════════════════
# ZEEMLESS Platform — Environment Configuration
# ═══════════════════════════════════════════════════════════════
# Kopiere diese Datei nach .env und fülle die Werte aus.
# .env ist in .gitignore und wird NICHT committed.
# Stand: 24. März 2026

# ─── App ─────────────────────────────────────────────────────
PORT=3000
HTTPS_PORT=3443
AUTH_USERNAME=admin
AUTH_PASSWORD=<PASSWORT>

# ─── TLS (für WebRTC/getUserMedia) ───────────────────────────
TLS_CERT=/etc/ssl/private/server.pem
TLS_KEY=/etc/ssl/private/server-key.pem

# ─── Datenbank (Shared RDS: 192.168.1.96) ───────────────────
DATABASE_URL=postgresql://root:<DB_PASSWORT>@192.168.1.96:5432/voiceagent


# ═══════════════════════════════════════════════════════════════
# AZURE OPENAI — Ressource: zeemlessArtInt (swedencentral)
# Endpoint: https://zeemlessartint.openai.azure.com/
# ═══════════════════════════════════════════════════════════════

AZURE_OPENAI_ENDPOINT=https://zeemlessartint.openai.azure.com/
AZURE_OPENAI_API_KEY=<DEIN_API_KEY>

# ┌─────────────────────────────────────────────────────────────
# │ DEPLOYED: Chat / Completion Modelle
# │ Deployment-Name          Modell                  Version       SKU              Cap
# │ gpt-4o                   gpt-4o                  2024-11-20    GlobalStandard   450
# │ gpt-4                    gpt-4.1                 2025-04-14    GlobalStandard   10
# │ gpt-4.1                  gpt-4.1                 2025-04-14    GlobalStandard   50
# │ zeemlessPlayground       gpt-4.1-mini            2025-04-14    Standard         120
# │ gpt-5-mini               gpt-5-mini              2025-08-07    GlobalStandard   20
# │ gpt-5-chat               gpt-5-chat              2025-10-03    GlobalStandard   50
# │ zeemlessPlayground4o     gpt-5.1                 2025-11-13    Standard         10
# │ o1-mini                  o4-mini                 2025-04-16    GlobalStandard   10
# │ o3-mini                  o3-mini                 2025-01-31    GlobalStandard   100
# └─────────────────────────────────────────────────────────────
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o

# ┌─────────────────────────────────────────────────────────────
# │ DEPLOYED: Realtime / Voice (WebRTC)
# │ gpt-realtime-15          gpt-realtime-1.5         2026-02-23    GlobalStandard   1
# │ gpt-4o-realtime-preview  gpt-4o-realtime-preview  2024-10-01    GlobalStandard   1  (⚠️ deprecated)
# └─────────────────────────────────────────────────────────────
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-15

# ┌─────────────────────────────────────────────────────────────
# │ DEPLOYED: Bilderzeugung
# │ Dalle3                   dall-e-3                 3.0           Standard         1
# └─────────────────────────────────────────────────────────────
AZURE_OPENAI_IMAGE_DEPLOYMENT=Dalle3

# ┌─────────────────────────────────────────────────────────────
# │ DEPLOYED: Embedding Modelle (zeemlessArtInt)
# │ text-embedding-ada-002   text-embedding-ada-002   2             Standard         120
# │ text-embedding-3-large   text-embedding-3-large   1             Standard         120
# │
# │ DEPLOYED: Embedding Modelle (openai-zeemless-dev, westeurope)
# │ text-embedding-3-small-2 text-embedding-3-small   1             GlobalStandard   150
# │ text-embedding-3-large   text-embedding-3-large   1             GlobalStandard   80
# │
# │ DEPLOYED: Embedding Modelle (openaisearchservice91212)
# │ emb-3-small              text-embedding-3-small   1             GlobalStandard   1
# │ emb-3-small-5            text-embedding-3-small   1             GlobalStandard   5
# └─────────────────────────────────────────────────────────────
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large


